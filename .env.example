# THE CINEMATIC AGENCY — Environment Variable Reference
# Copy this file to .env and fill in real values. Never commit .env.
# Real values for production live in Vercel environment variables.

# ── SUPABASE ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OPENAI / EXECUTOR ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=codex-mini-latest
OPENAI_EXECUTOR_TIMEOUT_MS=600000
OPENAI_EXECUTOR_MAX_RETRIES=2
EXECUTOR_TYPE=supervised

# ── OPENROUTER ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── GOOGLE ────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=

# ── PERPLEXITY ────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=

# ── KLING ─────────────────────────────────────────────────────────────────────
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ── HIGGSFIELD ────────────────────────────────────────────────────────────────
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ── FIRECRAWL ─────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── MAGIC ─────────────────────────────────────────────────────────────────────
MAGIC_API_KEY=

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN_CLAUDE=
TELEGRAM_BOT_TOKEN_TRUTH=
TELEGRAM_BOT_TOKEN_INTEGRATION=
TELEGRAM_CHAT_ID=

# ── VERCEL ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=

# ── NETLIFY ───────────────────────────────────────────────────────────────────
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_ID=

# ── GITHUB ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── VPS ACCESS ────────────────────────────────────────────────────────────────
VPS1_HOST=
VPS1_SSH=
VPS2_HOST=
VPS2_SSH_PASS=
N8N_DASHBOARD=

# ── EMAIL ─────────────────────────────────────────────────────────────────────
EMAIL_PRIMARY=
EMAIL_ALT=
